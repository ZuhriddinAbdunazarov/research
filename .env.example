# Copy to .env (local) or set in your hosting provider's environment settings.
# Free personal key: https://api.nasa.gov/  (DEMO_KEY is used if empty: ~30 req/hour/IP, 50/day)
# The key is only read by server.mjs / Netlify functions — it is never sent to the browser.
NASA_API_KEY=
# Optional: local server port (default 8080)
PORT=8080
